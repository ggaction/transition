{
  "name": "@ggaction/transition",
  "version": "0.1.1",
  "type": "module",
  "description": "Interruptible SVG and Canvas transitions for ggaction scenes",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ggaction/transition.git"
  },
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "docs/api.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:browser": "node test/browser.mjs && node test/canvas-browser.mjs",
    "check:docs": "node scripts/check-docs.js",
    "demo": "node examples/server.js",
    "test:package": "node test/package.mjs"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  },
  "homepage": "https://github.com/ggaction/transition#readme",
  "bugs": {
    "url": "https://github.com/ggaction/transition/issues"
  },
  "keywords": [
    "ggaction",
    "visualization",
    "animation",
    "canvas",
    "svg",
    "transition"
  ]
}
