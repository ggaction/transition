{
  "name": "@ggaction/transition",
  "version": "0.1.0",
  "type": "module",
  "description": "Interruptible SVG transitions for ggaction scenes",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ggaction/transition.git"
  },
  "exports": {
